generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

generator client_default {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model User {
  userId          String           @id @default(uuid())
  email           String           @unique
  password        String?
  status          StatusUser
  createdAt       DateTime         @default(now())
  lastLogin       DateTime?
  phoneNumber     String?
  avatar          String?
  isEmailVerified Boolean          @default(false)
  updatedAt       DateTime         @updatedAt
  refreshToken    String?
  provider        AuthProvider     @default(LOCAL)
  providerId      String?
  isOnline        Boolean          @default(false)
  lastActive      DateTime?
  accountLevel    AccountLevel     @default(NORMAL)
  violations      Int              @default(0)
  admin           Admin?
  candidate       Candidate?
  jobAlerts       JobAlert[]
  notifications   Notification[]
  recruiter       Recruiter?
  supportRequests SupportRequest[]
  userRoles       UserRole[]
  violationLogs   ViolationLog[]

  @@index([status])
  @@index([createdAt])
}

model Role {
  roleId    String     @id @default(uuid())
  roleName  String     @unique
  userRoles UserRole[]
}

model UserRole {
  userRoleId String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Notification {
  notificationId String   @id @default(uuid())
  userId         String
  title          String
  type           String   @default("info")
  isRead         Boolean  @default(false)
  metadata       Json?
  createdAt      DateTime @default(now())
  message        String
  link           String?
  user           User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model JobAlert {
  jobAlertId String   @id @default(uuid())
  userId     String
  keywords   String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [userId])
}

model Admin {
  adminId     String    @id @default(uuid())
  lastAction  String?
  userId      String    @unique
  fullName    String?   @default("Quản trị viên")
  permissions String[]  @default([])
  user        User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  companies   Company[]
}

model Candidate {
  candidateId        String            @id @default(uuid())
  fullName           String
  university         String?
  major              String?
  gpa                Float?
  cvUrl              String?
  userId             String            @unique
  birthYear          Int?
  currentSalary      String?
  degrees            Degree[]
  otherInfo          Json?
  desiredJob         Json?
  gender             String?
  industries         String[]          @default([])
  interests          String[]          @default([])
  isOpenToWork       Boolean           @default(false)
  languages          Json?
  location           String?
  softSkills         String[]          @default([])
  summary            String?
  totalYearsExp      Float?            @default(0)
  jobSearchExpiresAt DateTime?
  applications       Application[]
  cvs                CV[]
  user               User              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  reports            CandidateReport[]
  candidateReviews   CandidateReview[]
  candidateUnlocks   CandidateUnlock[]
  wallet             CandidateWallet?
  certifications     Certification[]
  companyReviews     CompanyReview[]
  conversations      Conversation[]
  experiences        Experience[]
  jobMatches         JobMatch[]
  projects           Project[]
  savedJobs          SavedJob[]
  skills             Skill[]
}

model Experience {
  experienceId String    @id @default(uuid())
  company      String
  role         String
  duration     String
  description  String?
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
}

model Certification {
  certificationId String             @id @default(uuid())
  name            String
  issuer          String?
  issueDate       String?
  credentialId    String?
  credentialUrl   String?
  fileUrl         String?
  status          VerificationStatus @default(UNVERIFIED)
  adminFeedback   String?
  aiVerification  Json?
  candidateId     String
  candidate       Candidate          @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
}

model Degree {
  degreeId      String             @id @default(uuid())
  name          String
  school        String
  major         String?
  issueDate     String?
  fileUrl       String?
  status        VerificationStatus @default(UNVERIFIED)
  issuer        String?
  credentialId  String?
  adminFeedback String?
  aiVerification Json?
  candidateId   String
  candidate     Candidate          @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model Skill {
  skillId     String     @id @default(uuid())
  skillName   String
  candidateId String
  category    String?
  level       SkillLevel @default(BEGINNER)
  candidate   Candidate  @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
}

model Project {
  projectId   String    @id @default(uuid())
  projectName String
  description String?
  role        String?
  technology  String?
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
}

model Recruiter {
  recruiterId           String                 @id @default(uuid())
  bio                   String?
  position              String?
  userId                String                 @unique
  companyId             String?
  savedCandidateIds     String[]
  aiInsightsCache       Json?
  aiInsightsCacheKey    String?
  aiInsightsCachedAt    DateTime?
  companyRole           String                 @default("MASTER")
  createdAt             DateTime               @default(now())
  fullName              String?                @default("Nhà tuyển dụng")
  interviewSettings     Json?
  updatedAt             DateTime               @default(now()) @updatedAt
  violationCount        Int                    @default(0)
  reports               CandidateReport[]
  candidateReviews      CandidateReview[]
  candidateUnlocks      CandidateUnlock[]
  reviewReports         CompanyReviewReport[]
  conversations         Conversation[]
  evaluations           InterviewEvaluation[]
  jobPostings           JobPosting[]
  company               Company?               @relation(fields: [companyId], references: [companyId])
  user                  User                   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  recruiterSubscription RecruiterSubscription?
  transactions          Transaction[]
}

model Transaction {
  transactionId String          @id @default(uuid())
  amount        Int
  description   String?
  createdAt     DateTime        @default(now())
  walletId      String
  recruiterId   String?
  orderCode     Int?            @unique
  status        String          @default("SUCCESS")
  realMoney     Float?
  type          TransactionType
  recruiter     Recruiter?      @relation(fields: [recruiterId], references: [recruiterId])
  wallet        CompanyWallet   @relation(fields: [walletId], references: [walletId], onDelete: Cascade)
}

model Company {
  companyId          String            @id @default(uuid())
  companyName        String
  taxCode            String?           @unique
  isRegistered       Boolean           @default(false)
  verifyStatus       Int               @default(0)
  logo               String?
  banner             String?
  address            String?
  description        String?
  websiteUrl         String?
  companySize        Int?
  businessLicenseUrl String?
  adminId            String?
  cultureContent     Json?
  enterpriseType     String?
  internationalName  String?
  mainIndustry       String?
  operatingDate      String?
  shortName          String?
  slug               String?           @unique
  status             String?
  taxAddress         String?
  candidateUnlocks   CandidateUnlock[]
  admin              Admin?            @relation(fields: [adminId], references: [adminId])
  benefits           CompanyBenefit[]
  branches           CompanyBranch[]
  history            CompanyHistory[]
  companyReviews     CompanyReview[]
  sections           CompanySection[]
  wallet             CompanyWallet?
  jobPostings        JobPosting[]
  recruiters         Recruiter[]

  @@index([verifyStatus])
  @@index([companyName])
}

model CompanySection {
  id           String  @id @default(uuid())
  title        String
  content      String
  type         String  @default("GENERAL")
  displayOrder Int     @default(0)
  companyId    String
  company      Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
}

model CompanyBenefit {
  id        String  @id @default(uuid())
  title     String
  icon      String?
  companyId String
  company   Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
}

model CompanyHistory {
  id        String  @id @default(uuid())
  year      String
  event     String
  companyId String
  company   Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
}

model CompanyBranch {
  branchId    String             @id @default(uuid())
  name        String
  address     String
  latitude    Float?
  longitude   Float?
  isVerified  Boolean            @default(false)
  companyId   String
  company     Company            @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  jobPostings JobPostingBranch[]
}

model JobPosting {
  jobPostingId           String             @id @default(uuid())
  title                  String
  description            String?
  requirements           String?
  benefits               String?
  salaryMin              Decimal?           @db.Decimal(19, 0)
  salaryMax              Decimal?           @db.Decimal(19, 0)
  currency               String?            @default("VND")
  jobType                JobType?
  experience             String?
  vacancies              Int                @default(1)
  locationCity           String?
  status                 JobStatus          @default(PENDING)
  isVerified             Boolean            @default(false)
  aiReliabilityScore     Float?
  createdAt              DateTime           @default(now()) @db.Timestamp(6)
  updatedAt              DateTime           @updatedAt @db.Timestamp(6)
  approvedBy             String?
  recruiterId            String?
  companyId              String
  structuredRequirements Json?
  viewCount              Int                @default(0)
  autoInviteMatches      Boolean            @default(false)
  autoInviteThreshold    Int                @default(70)
  autoRejectThreshold    Int?
  jobLevel               JobLevel?          @default(STAFF)
  jobTier                JobTier            @default(BASIC)
  matchMode              String             @default("BALANCED")
  moderationFeedback     Json?
  pausedAt               DateTime?          @db.Timestamp(6)
  refreshedAt            DateTime           @default(now()) @db.Timestamp(6)
  slug                   String?            @unique
  slaApplicationDays     Int                @default(3)
  slaInterviewDays       Int                @default(5)
  applications           Application[]
  candidateUnlocks       CandidateUnlock[]
  jobMatches             JobMatch[]
  company                Company            @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  recruiter              Recruiter?         @relation(fields: [recruiterId], references: [recruiterId])
  branches               JobPostingBranch[]
  savedJobs              SavedJob[]

  @@index([status])
  @@index([companyId])
  @@index([recruiterId])
  @@index([createdAt])
  @@index([jobTier])
}

model JobPostingBranch {
  jobPostingId String
  branchId     String
  branch       CompanyBranch @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  jobPosting   JobPosting    @relation(fields: [jobPostingId], references: [jobPostingId], onDelete: Cascade)

  @@id([jobPostingId, branchId])
}

model JobMatch {
  matchId       String     @id @default(uuid())
  score         Float
  matchedSkills String[]
  details       Json?
  candidateId   String
  jobPostingId  String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  candidate     Candidate  @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
  jobPosting    JobPosting @relation(fields: [jobPostingId], references: [jobPostingId], onDelete: Cascade)

  @@unique([candidateId, jobPostingId])
}

model CV {
  cvId             String            @id @default(uuid())
  cvTitle          String
  fileUrl          String?
  isMain           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  candidateId      String
  fileHash         String?
  parsedData       Json?
  applications     Application[]
  candidate        Candidate         @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
  candidateUnlocks CandidateUnlock[]
}

model Application {
  applicationId       String                @id @default(uuid())
  applyDate           DateTime              @default(now())
  appStatus           AppStatus             @default(PENDING)
  cvSnapshotUrl       String
  coverLetter         String?
  feedback            String?
  candidateId         String
  jobPostingId        String
  cvId                String
  interviewDate       DateTime?
  interviewLocation   String?
  interviewTime       String?
  aiMatchScore        Float?
  isUnlocked          Boolean               @default(false)
  candidateResponseAt DateTime?
  expectedResponseAt  DateTime?
  expectedResultAt    DateTime?
  candidate           Candidate             @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
  cv                  CV                    @relation(fields: [cvId], references: [cvId], onDelete: Cascade)
  jobPosting          JobPosting            @relation(fields: [jobPostingId], references: [jobPostingId], onDelete: Cascade)
  reports             CandidateReport[]
  companyReview       CompanyReview?
  evaluations         InterviewEvaluation[]
}

model SavedJob {
  savedJobId   String     @id @default(uuid())
  savedAt      DateTime   @default(now())
  candidateId  String
  jobPostingId String
  candidate    Candidate  @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [jobPostingId], onDelete: Cascade)

  @@unique([candidateId, jobPostingId])
}

model Conversation {
  conversationId String    @id @default(uuid())
  candidateId    String
  recruiterId    String
  lastMessage    String?
  isRead         Boolean   @default(false)
  updatedAt      DateTime  @updatedAt
  userId         String?
  candidate      Candidate @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
  recruiter      Recruiter @relation(fields: [recruiterId], references: [recruiterId], onDelete: Cascade)
  messages       Message[]
}

model Message {
  messageId      String       @id @default(uuid())
  content        String
  sentAt         DateTime     @default(now())
  isRead         Boolean      @default(false)
  conversationId String
  senderId       String
  fileName       String?
  fileSize       Int?
  fileType       String?
  fileUrl        String?
  conversation   Conversation @relation(fields: [conversationId], references: [conversationId], onDelete: Cascade)
}

model CompanyWallet {
  walletId         String        @id @default(uuid())
  companyId        String        @unique
  balance          Int           @default(0)
  updatedAt        DateTime      @updatedAt
  cvUnlockQuota    Int           @default(0)
  cvUnlockQuotaMax Int           @default(0)
  company          Company       @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  transactions     Transaction[]
}

model CandidateWallet {
  walletId     String                 @id @default(uuid())
  candidateId  String                 @unique
  balance      Int                    @default(0)
  updatedAt    DateTime               @updatedAt
  transactions CandidateTransaction[]
  candidate    Candidate              @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
}

model CandidateTransaction {
  transactionId String          @id @default(uuid())
  amount        Int
  description   String?
  createdAt     DateTime        @default(now())
  walletId      String
  candidateId   String?
  orderCode     Int?            @unique
  status        String          @default("SUCCESS")
  realMoney     Float?
  type          TransactionType
  wallet        CandidateWallet @relation(fields: [walletId], references: [walletId], onDelete: Cascade)
}

model RecruiterSubscription {
  subscriptionId  String    @id @default(uuid())
  recruiterId     String    @unique
  planType        PlanType
  maxBasicPosts   Int       @default(0)
  usedBasicPosts  Int       @default(0)
  maxVipPosts     Int       @default(0)
  usedVipPosts    Int       @default(0)
  maxUrgentPosts  Int       @default(0)
  usedUrgentPosts Int       @default(0)
  expiryDate      DateTime
  canViewAIReport Boolean   @default(false)
  isCancelled     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  recruiter       Recruiter @relation(fields: [recruiterId], references: [recruiterId], onDelete: Cascade)
}

model SupportRequest {
  requestId String        @id @default(uuid())
  name      String?
  email     String
  subject   String
  message      String
  attachmentUrl String?
  status       SupportStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  userId    String?
  user      User?         @relation(fields: [userId], references: [userId])
}

model AiQueryCache {
  id        String   @id @default(uuid())
  query     String   @unique
  response  String
  createdAt DateTime @default(now())
}

model CandidateUnlock {
  unlockId         String     @id @default(uuid())
  recruiterId      String
  candidateId      String
  jobPostingId     String
  unlockedAt       DateTime   @default(now())
  creditSpent      Int        @default(0)
  cvId             String
  companyCompanyId String?
  candidate        Candidate  @relation(fields: [candidateId], references: [candidateId])
  company          Company?   @relation(fields: [companyCompanyId], references: [companyId])
  cv               CV         @relation(fields: [cvId], references: [cvId], onDelete: Cascade)
  jobPosting       JobPosting @relation(fields: [jobPostingId], references: [jobPostingId])
  recruiter        Recruiter  @relation(fields: [recruiterId], references: [recruiterId])

  @@unique([recruiterId, candidateId, jobPostingId])
  @@index([recruiterId])
}

model CandidateReview {
  reviewId     String    @id @default(uuid())
  candidateId  String
  recruiterId  String
  jobPostingId String?
  rating       Int       @default(0)
  content      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  candidate    Candidate @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
  recruiter    Recruiter @relation(fields: [recruiterId], references: [recruiterId], onDelete: Cascade)
}

model ViolationLog {
  logId     String   @id @default(uuid())
  userId    String
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

model InterviewEvaluation {
  evaluationId   String      @id @default(uuid())
  applicationId  String
  recruiterId    String
  roundNumber    Int         @default(1)
  roundName      String?
  sessionDate    DateTime?
  criteriaScores Json        @default("[]")
  overallRating  Int         @default(0)
  notes          String?
  result         EvalResult  @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  application    Application @relation(fields: [applicationId], references: [applicationId], onDelete: Cascade)
  recruiter      Recruiter   @relation(fields: [recruiterId], references: [recruiterId], onDelete: Cascade)

  @@unique([applicationId, recruiterId, roundNumber])
  @@index([applicationId])
  @@index([recruiterId])
  @@index([sessionDate])
}

model CompanyReview {
  reviewId          String                @id @default(uuid())
  companyId         String
  candidateId       String
  applicationId     String                @unique
  ratingProcess     Int                   @default(0)
  ratingInterviewer Int                   @default(0)
  ratingOffice      Int                   @default(0)
  content           String?
  isAnonymous       Boolean               @default(false)
  isVerified        Boolean               @default(true)
  status            String                @default("PUBLISHED")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  application       Application           @relation(fields: [applicationId], references: [applicationId], onDelete: Cascade)
  candidate         Candidate             @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
  company           Company               @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  reports           CompanyReviewReport[]

  @@index([companyId])
  @@index([candidateId])
}

model CandidateReport {
  reportId      String       @id @default(uuid())
  recruiterId   String
  candidateId   String
  applicationId String?
  reason        String
  content       String
  status        String       @default("PENDING")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  application   Application? @relation(fields: [applicationId], references: [applicationId])
  candidate     Candidate    @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
  recruiter     Recruiter    @relation(fields: [recruiterId], references: [recruiterId], onDelete: Cascade)

  @@index([recruiterId])
  @@index([candidateId])
}

model CompanyReviewReport {
  reportId    String        @id @default(uuid())
  reviewId    String
  recruiterId String
  reason      String
  evidence    String
  status      String        @default("PENDING")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  recruiter   Recruiter     @relation(fields: [recruiterId], references: [recruiterId], onDelete: Cascade)
  review      CompanyReview @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)

  @@index([reviewId])
  @@index([recruiterId])
}

enum AuthProvider {
  LOCAL
  GOOGLE
  LINKEDIN
}

enum StatusUser {
  ACTIVE
  LOCKED
  BANNED
}

enum AccountLevel {
  NORMAL
  PROBATION
}

enum FilterAction {
  EXCLUDE
  INCLUDE
}

enum JobType {
  FULLTIME
  PARTTIME
  REMOTE
  INTERNSHIP
  OTHER
}

enum JobLevel {
  INTERN
  STAFF
  MANAGER
  DIRECTOR
  TEAM_LEADER
  DEPARTMENT_HEAD
  BRANCH_MANAGER
  VICE_DIRECTOR
}

enum AppStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
  INTERVIEWING
  INTERVIEW_CONFIRMED
  RESCHEDULE_REQUESTED
}

enum JobStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CLOSED
  PAUSED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PlanType {
  LITE
  GROWTH
}

enum JobTier {
  BASIC
  PROFESSIONAL
  URGENT
}

enum TransactionType {
  DEPOSIT
  BUY_PACKAGE
  POST_JOB
  OPEN_CV
  ACTIVATE_JOB_SEARCH
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum EvalResult {
  PENDING
  PASS
  FAIL
}
